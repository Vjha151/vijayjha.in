[Unit]
Description=VijayJha.in Node application
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/vijayjha
Environment=NODE_ENV=production
Environment=PORT=3000
EnvironmentFile=/etc/vijayjha.env
ExecStart=/usr/bin/node server.mjs
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/var/www/vijayjha/data

[Install]
WantedBy=multi-user.target
