[Unit]
Description=VijayJha Vehicle Manager expiry reminders
After=network-online.target vijayjha.service

[Service]
Type=oneshot
User=www-data
Group=www-data
WorkingDirectory=/var/www/vijayjha
Environment=NODE_ENV=production
Environment=TZ=Asia/Kolkata
EnvironmentFile=/etc/vijayjha.env
ExecStart=/usr/bin/npm run reminders
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/var/www/vijayjha/data
UMask=0077
